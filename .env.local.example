# Supabase project settings (Project Settings -> API / Database in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection string (Project Settings -> Database -> Connection string -> URI)
# Used by drizzle-kit and by scripts/ (ingestion jobs run from GitHub Actions).
DATABASE_URL=

# console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=

# resend.com -> API Keys. RESEND_FROM_EMAIL must be on a domain you've verified
# with Resend, or use the shared onboarding@resend.dev sender for testing.
RESEND_API_KEY=
RESEND_FROM_EMAIL="GetHired <onboarding@resend.dev>"

# Public URL of the deployed app, used to build links inside notification emails.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Web push. Generate a keypair once with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# The public key is safe to expose client-side (NEXT_PUBLIC_*); the private
# key is not — never commit it or expose it to the browser.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
